# =============================================================================
# Hêz Fitness Tracker — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hêz

# ─── Supabase ────────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── PWA / Service Worker ────────────────────────────────────────────────────
NEXT_PUBLIC_PWA_ENABLED=true

# ─── Web Push (VAPID) ───────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@hez.fit

# ─── Analytics (PostHog) ────────────────────────────────────────────────────
# Sign up at https://posthog.com or self-host
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Error Monitoring (Sentry) ───────────────────────────────────────────────
# Sign up at https://sentry.io
SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ─── Optional: Feature Flags ─────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ONBOARDING=true
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
